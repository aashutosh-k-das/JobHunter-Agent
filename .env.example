OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Google Sheets (optional; if unset, results are logged to applications.csv)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json
GOOGLE_SHEET_ID=your-spreadsheet-id-from-the-url

# Where Playwright keeps your logged-in browser profile
BROWSER_PROFILE_DIR=.browser_profile
HEADLESS=false
